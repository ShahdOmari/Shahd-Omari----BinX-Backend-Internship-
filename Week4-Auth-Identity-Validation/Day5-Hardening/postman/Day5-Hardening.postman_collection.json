                  "// to this controller without actually needing 100 requests to prove it —\r",
                  "// a normal successful call under the limit still passes through the\r",
                  "// RateLimiter middleware, just without being rejected.\r",
                  "pm.test(\"Request succeeds under the general rate limit\", () => {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});"
                ],
                "type": "text/javascript",
