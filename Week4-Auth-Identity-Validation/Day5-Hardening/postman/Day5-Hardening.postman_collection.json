        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Documents both possible outcomes: the request either succeeds/fails\r",
                  "// authentication normally (200/401), or gets rejected by the rate\r",
                  "// limiter entirely (429) before authentication logic even runs.\r",
                  "pm.test(\"Status is 200, 401, or 429 (rate limited)\", () => {\r",
                  "    pm.expect([200, 401, 429]).to.include(pm.response.code);\r",
                  "});\r",
                  "\r",
                  "if (pm.response.code === 429) {\r",
                  "    console.log(\"✅ Rate limit triggered — login endpoint is protected.\");\r",
                  "} else if (pm.response.code === 200) {\r",
                  "    const response = pm.response.json();\r",
                  "    pm.environment.set(\"token\", response.token);\r",
                  "    console.log(\"Login succeeded, token saved.\");\r",
                  "} else {\r",
                  "    console.log(\"Login failed (401) — expected if credentials are wrong or limit not yet hit.\");\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"test54@binx.com\", \"password\": \"Day5Test@123\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/Auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "Auth",
                "login"
              ]
            }
          },
          "response": []
        }
