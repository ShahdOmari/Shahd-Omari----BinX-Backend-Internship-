        {
          "name": "02 - Register (Weak Password) → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", () => {\r",
                  "    pm.response.to.have.status(400);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains errors array\", () => {\r",
                  "    pm.expect(pm.response.json()).to.have.property(\"errors\");\r",
                  "    pm.expect(pm.response.json().errors).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Errors mention password requirements\", () => {\r",
                  "    const errors = pm.response.json().errors.join(\" \");\r",
                  "    pm.expect(errors).to.include(\"Passwords must\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"test@binx.com\",\r\n  \"password\": \"123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
