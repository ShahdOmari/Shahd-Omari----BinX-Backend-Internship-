    {
      "name": "Auth",
      "item": [
        {
          "name": "01 - Register (Valid) → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", () => {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains a userId\", () => {\r",
                  "    pm.expect(pm.response.json()).to.have.property(\"userId\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains success message\", () => {\r",
                  "    pm.expect(pm.response.json().message).to.eql(\"User registered successfully.\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"shahd.week4@binx.com\",\r\n  \"password\": \"SecureP@ss123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "### Purpose\n\nRegisters a new user with a valid email and a password meeting  \nIdentity's default policy (6+ chars, upper, lower, non-alphanumeric).\n\n### Expected Response\n\n`200 OK`\n\n``` json\n{\n  \"message\": \"User registered successfully.\",\n  \"userId\": \"<generated-guid>\"\n}\n\n ```\n\n### Notes\n\nThe password is hashed by Identity's UserManager before storage —  \nnever stored or returned in plaintext."
          },
          "response": [
            {
              "name": "Success Example",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\r\n  \"email\": \"shahd.week4@binx.com\",\r\n  \"password\": \"SecureP@ss123\"\r\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/auth/register",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "auth",
                    "register"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": null,
              "header": [
