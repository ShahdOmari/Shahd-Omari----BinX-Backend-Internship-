      "name": "Tasks",
      "item": [
        {
          "name": "Create Task - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", () => {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response has an id\", () => {\r",
                  "    pm.expect(pm.response.json()).to.have.property(\"id\");\r",
                  "});\r",
                  "\r",
                  "// Save the created task's id as a collection variable, so the\r",
                  "// following requests can reference it dynamically instead of\r",
                  "// assuming it's always 1 — the database's auto-increment counter\r",
                  "// doesn't reset between test runs.\r",
                  "pm.collectionVariables.set(\"taskId\", pm.response.json().id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"title\": \"Design database schema\",\r\n  \"priorityLevel\": 3,\r\n  \"projectId\": 1,\r\n  \"assignedToUserId\": 1\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
